<template lang="pug">
.calendar
  .calendar-header
    button.prev-month(@click="prevMonth") ←
    h2 {{ currentMonthYear }}
    button.next-month(@click="nextMonth") →

  .calendar-controls
    .people-selector
      h3 Люди:
      .people-checkboxes
        .person-checkbox(
          v-for="person in allPeople"
          :key="person.id")
          input(
            type="checkbox"
            :id="`person-${person.id}`"
            :checked="isPersonSelected(person.id)"
            @change="togglePerson(person.id)"
          )
          label(:for="`person-${person.id}`") {{ person.name }}

  .calendar-grid
    .day-header(v-for="day in dayNames" :key="day") {{ day }}

    .empty-cell(v-for="n in emptyCells" :key="`empty-${n}`")

    .day-cell(
      v-for="day in daysInMonth"
      :key="day"
      :class="{'current-day': isCurrentDay(day),'has-period': hasPeriodOnDay(day)}"
      :style="getDayCellStyles(day)"
      @click="handleDayClick(day)"
    )
      .day-number {{ day }}
      .day-periods
        .period-marker(
          v-for="period in getPeriodsForDay(day)"
          :key="`${period.personId}-${period.startDate}`"
          :style="{ backgroundColor: getPersonColor(period.personId) }"
          :title="getPeriodTooltip(period)"
        )

  .calendar-legend(v-if="selectedPeople.length")
    h3 Легенда (выбранные люди)
    .legend-items
      .legend-item(
        v-for="person in selectedPeople"
        :key="person.id"
      )
        .legend-color(:style="{ backgroundColor: person.color }")
        .legend-name {{ person.name }}
</template>
    <script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

// Типы
interface Person {
  id: string
  name: string
  color: string
  periods: DatePeriod[]
}

interface DatePeriod {
  startDate: string // YYYY-MM-DD
  endDate: string // YYYY-MM-DD
  personId: string
  type?: string // опционально, для разных типов периодов
}

interface CalendarDay {
  date: Date
  day: number
  periods: DatePeriod[]
}

// Props
interface Props {
  people: Person[]
  selectedPersonIds?: string[]
}

const props = withDefaults(defineProps<Props>(), {
  selectedPersonIds: () => []
})

// Emits
const emit = defineEmits<{
  dayClick: [date: Date, periods: DatePeriod[]]
  personToggle: [personId: string, selected: boolean]
}>()

// Data
const currentDate = ref(new Date())
const selectedPeopleIds = ref<string[]>(props.selectedPersonIds)

// Computed
const currentMonthYear = computed(() => {
  return currentDate.value.toLocaleDateString('ru-RU', {
    month: 'long',
    year: 'numeric'
  })
})

const daysInMonth = computed(() => {
  const year = currentDate.value.getFullYear()
  const month = currentDate.value.getMonth()
  return new Date(year, month + 1, 0).getDate()
})

const firstDayOfMonth = computed(() => {
  const year = currentDate.value.getFullYear()
  const month = currentDate.value.getMonth()
  const firstDay = new Date(year, month, 1).getDay()
  return firstDay === 0 ? 7 : firstDay // Приводим к формату Пн-Вс (1-7)
})

const emptyCells = computed(() => {
  return firstDayOfMonth.value - 1
})

const allPeople = computed(() => props.people)

const selectedPeople = computed(() => {
  return props.people.filter(person => 
    selectedPeopleIds.value.includes(person.id)
  )
})

const dayNames = computed(() => ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'])

// Methods
const prevMonth = (): void => {
  currentDate.value = new Date(
    currentDate.value.getFullYear(),
    currentDate.value.getMonth() - 1,
    1
  )
}

const nextMonth = (): void => {
  currentDate.value = new Date(
    currentDate.value.getFullYear(),
    currentDate.value.getMonth() + 1,
    1
  )
}

const isCurrentDay = (day: number): boolean => {
  const today = new Date()
  return (
    today.getDate() === day &&
    today.getMonth() === currentDate.value.getMonth() &&
    today.getFullYear() === currentDate.value.getFullYear()
  )
}

const formatDateKey = (day: number): string => {
  const year = currentDate.value.getFullYear()
  const month = currentDate.value.getMonth() + 1
  return `${year}-${month.toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`
}

const isDateInPeriod = (date: string, period: DatePeriod): boolean => {
  return date >= period.startDate && date <= period.endDate
}

const getPeriodsForDay = (day: number): DatePeriod[] => {
  const dateKey = formatDateKey(day)
  const periods: DatePeriod[] = []

  props.people.forEach(person => {
    person.periods.forEach(period => {
      if (isDateInPeriod(dateKey, period) && selectedPeopleIds.value.includes(person.id)) {
        periods.push(period)
      }
    })
  })

  return periods
}

const hasPeriodOnDay = (day: number): boolean => {
  return getPeriodsForDay(day).length > 0
}

const getDayCellStyles = (day: number): { backgroundColor: string } => {
  const periods = getPeriodsForDay(day)
  
  if (periods.length === 0) {
    return { backgroundColor: '' }
  }

  if (periods.length === 1) {
    const person = props.people.find(p => p.id === periods[0].personId)
    return { backgroundColor: person?.color || '' }
  }

  // Если несколько периодов в один день - создаем градиент
  const colors = periods.map(period => {
    const person = props.people.find(p => p.id === period.personId)
    return person?.color || '#ccc'
  })

  if (colors.length === 2) {
    return { backgroundColor: `linear-gradient(135deg, ${colors[0]} 50%, ${colors[1]} 50%)` }
  } else {
    // Для большего количества цветов используем первый цвет с прозрачностью
    return { backgroundColor: `${colors[0]}80` } // 80 = 50% прозрачность
  }
}

const getPersonColor = (personId: string): string => {
  const person = props.people.find(p => p.id === personId)
  return person?.color || '#ccc'
}

const getPeriodTooltip = (period: DatePeriod): string => {
  const person = props.people.find(p => p.id === period.personId)
  return `${person?.name || 'Неизвестный'}: ${formatDate(period.startDate)} - ${formatDate(period.endDate)}`
}

const formatDate = (dateString: string): string => {
  return new Date(dateString).toLocaleDateString('ru-RU')
}

const handleDayClick = (day: number): void => {
  const date = new Date(
    currentDate.value.getFullYear(),
    currentDate.value.getMonth(),
    day
  )
  const periods = getPeriodsForDay(day)
  emit('dayClick', date, periods)
}

const isPersonSelected = (personId: string): boolean => {
  return selectedPeopleIds.value.includes(personId)
}

const togglePerson = (personId: string): void => {
  const isSelected = selectedPeopleIds.value.includes(personId)
  
  if (isSelected) {
    selectedPeopleIds.value = selectedPeopleIds.value.filter(id => id !== personId)
  } else {
    selectedPeopleIds.value = [...selectedPeopleIds.value, personId]
  }
  
  emit('personToggle', personId, !isSelected)
}

// Lifecycle
onMounted(() => {
  // Если нет выбранных людей, выбираем всех по умолчанию
  if (selectedPeopleIds.value.length === 0 && props.people.length > 0) {
    selectedPeopleIds.value = props.people.map(person => person.id)
  }
})
</script>

    
